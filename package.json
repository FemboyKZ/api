{
  "name": "server-api",
  "version": "1.0.0",
  "description": "FKZ Game Server API",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.11.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "npx eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:aggregate": "curl -X POST http://localhost:3000/admin/aggregate-daily",
    "admin:cleanup": "curl -X POST http://localhost:3000/admin/cleanup-history?days=30"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "gamedig": "^5.3.3",
    "http-proxy-agent": "^9.1.0",
    "https-proxy-agent": "^9.1.0",
    "mysql2": "^3.24.5",
    "rcon-srcds": "^2.1.1",
    "redis": "^6.3.0",
    "socket.io": "^4.8.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  },
  "keywords": [
    "game-server",
    "api",
    "tracking",
    "websocket",
    "realtime"
  ],
  "author": "jvnipers",
  "license": "MIT",
  "allowScripts": {
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
